{
  "name": "mysql-mcp",
  "version": "1.0.0",
  "description": "Enterprise-grade, secure, AST-validated MySQL MCP server for any AI agent (Antigravity, Claude, Cursor, Devin, Codex) with SSH tunneling, granular safety gates, and write approval policies",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mysql-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kavi-200312/mysql-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepack": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "mcp",
    "mysql",
    "model-context-protocol",
    "ai-agent",
    "security",
    "antigravity",
    "claude",
    "cursor",
    "devin"
  ],
  "author": "Kavi-200312",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0",
    "node-sql-parser": "^5.3.5",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
