# ==============================================================================
# Enterprise MySQL MCP Server - Environment Configuration
# Copy this file to .env and fill in your database credentials.
# ==============================================================================

# --- SSH Tunnel Configuration (Set SSH_ENABLED=false if connecting directly) ---
SSH_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_LOCAL_PORT=13306
SSH_REMOTE_HOST=127.0.0.1
SSH_REMOTE_PORT=3306

# --- Database Connection ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_dev_database
DB_SSL=auto   # 'true', 'false', or 'auto' (enables SSL for port 25060 or cloud hosts)

# --- Dedicated Database Users (Recommended least-privilege) ---
DB_READER_USER=ai_agent_reader
DB_READER_PASSWORD=your_reader_password
DB_WRITER_USER=ai_agent_writer
DB_WRITER_PASSWORD=your_writer_password

# ==============================================================================
# SECURITY & PERMISSION POLICY CONFIGURATION (Fully Customizable)
# ==============================================================================
# Global Policy Mode:
#   - 'strict'     : (Default) DDL & DELETE blocked. All writes require approval.
#   - 'prompt'     : Configured operations allowed, but prompt for user approval.
#   - 'autonomous' : AI executes all allowed operations without asking approval.
POLICY_MODE=strict

# Operation Permissions (Safe defaults: Destructive actions disabled)
POLICY_ALLOW_DELETE=false        # Allow DELETE statements (requires WHERE)
POLICY_ALLOW_DDL=false           # Allow CREATE, ALTER, DROP, TRUNCATE

# Safeguard Enforcements
POLICY_REQUIRE_WHERE=true        # Block UPDATE / DELETE without a WHERE clause

# Granular Auto-Approval Flags (Set to true to skip confirmation prompts per op)
POLICY_AUTO_APPROVE_INSERT=false
POLICY_AUTO_APPROVE_UPDATE=false
POLICY_AUTO_APPROVE_DELETE=false
POLICY_AUTO_APPROVE_DDL=false

# --- Operational Limits ---
DB_QUERY_TIMEOUT_MS=15000
DB_MAX_ROWS=500
DB_MAX_PAYLOAD_BYTES=524288
APPROVAL_EXPIRY_SECONDS=300
BULK_AFFECTED_ROW_THRESHOLD=10
LOG_LEVEL=info
